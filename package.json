{
    "$schema": "https://json.schemastore.org/package",
    "name": "@kayahr/harmless",
    "version": "0.1.2",
    "type": "module",
    "description": "A minimalistic reactive web framework written in TypeScript",
    "keywords": [
        "javascript",
        "typescript",
        "web",
        "frontend",
        "framework",
        "ui",
        "reactive",
        "fine-grained-reactivity",
        "signals",
        "jsx",
        "components",
        "dom",
        "dependency-injection",
        "lightweight",
        "svg",
        "mathml"
    ],
    "license": "MIT",
    "author": "Klaus Reimer <k@ailis.de>",
    "repository": "github:kayahr/harmless",
    "homepage": "https://github.com/kayahr/harmless",
    "bugs": "https://github.com/kayahr/harmless/issues",
    "funding": "https://github.com/kayahr/harmless?sponsor=1",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "lib/main/",
        "src/main/"
    ],
    "exports": {
        ".": "./lib/main/index.js",
        "./jsx-runtime": "./lib/main/jsx-runtime.js",
        "./jsx-dev-runtime": "./lib/main/jsx-runtime.js"
    },
    "scripts": {
        "clean": "rm -rf lib",
        "build": "run build:*",
        "build:importmap": "importmap lib/importmap.js",
        "build:compile": "tsc",
        "test": "run test:*",
        "pretest:unit": "npm run build:compile",
        "test:unit": "ntest",
        "test:lint": "oxlint --type-aware --deny-warnings",
        "test:apidoc": "typedoc --emit none",
        "test:spell": "cspell --no-progress --no-summary",
        "apidoc": "typedoc",
        "prepare": "run clean build"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "20.11.2",
        "@kayahr/assert": "1.5.0",
        "@kayahr/cspell": "10.0.1-bundle.2",
        "@kayahr/importmap": "0.1.0",
        "@kayahr/npm-utils": "1.1.2",
        "@kayahr/ntest": "1.3.0",
        "@kayahr/oxlint-config": "1.40.0",
        "@kayahr/typedoc": "0.28.20-bundle.1",
        "@types/node": "26.2.0",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "@kayahr/di": "^1.0.0",
        "@kayahr/observable": "^1.2.0",
        "@kayahr/scope": "^1.2.0",
        "@kayahr/signal": "^6.1.1"
    }
}
